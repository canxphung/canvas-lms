development:
  storage: local
  # the secure option in this file is deprecated, use the ssl option in domain.yml instead
  # secure: false
  path_prefix: tmp/files

test:
  storage: local
  path_prefix: tmp/files

production:
  storage: local
  path_prefix: tmp/files

## S3-compatible storage example. Requires valid amazon_s3.yml.
## This can point at AWS S3, MinIO, LocalStack, or another compatible service.
